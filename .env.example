# Kopiér til server/.env til lokal udvikling (se README) — udfyld ALDRIG denne fil med rigtige
# værdier og commit den aldrig. Serveren bruger Managed Identity i Azure; lokalt falder
# DefaultAzureCredential tilbage til din egen `az login`-session, så CLIENT_ID/SECRET er ikke
# nødvendige nogen steder i denne løsning.

SHAREPOINT_SITE_ID=
ENTRIES_LIST_ID=
TRIPS_LIST_ID=
SYSTEM_LIST_ID=
TOKEN_HASH_PEPPER=
SESSION_SIGNING_SECRET=
RATE_LIMIT_PEPPER=
PUBLIC_APP_URL=https://c.h-aa.dk
PORT=8080
